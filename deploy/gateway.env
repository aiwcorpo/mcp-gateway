# Configuration of the gateway. Fill in the empty values; "docker compose up -d" tells you what is still missing.
# Passwords of the gateway's PostgreSQL and Redis, the internal JWT keys and the cursor keys are generated on the first start.

# The address users put in their AI client: the https origin of your reverse proxy in front of port 8080.
MCP_PUBLIC_URL=

# Identity provider (a Keycloak realm): issuer and the URL of its signing keys.
# For Keycloak: https://<host>/realms/<realm> and https://<host>/realms/<realm>/protocol/openid-connect/certs
MCP_OIDC_ISSUER=
MCP_OIDC_JWKS_URI=

# Credential broker: its internal TLS address. Its certificate must name mcp-credential-broker.internal; the host in the URL may differ.
MCP_BROKER_URL=
MCP_BROKER_TLS_NAME=mcp-credential-broker.internal

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# AI clients (the azp of the IdP token) that may call tools. Without the line: claude-code and claude-ai.
# MCP_ALLOWED_CLIENTS=claude-code,claude-ai

# MCP servers are trusted per server when you approve its connection: ca (the default trust store of the JVM), pinned (one certificate) or plain.
# For servers whose certificates come from your company CA, put its certificate(s) as a PEM file in certs/ and name it here; the gateway then
# accepts that CA for the ca trust in addition to the default store (the certificate must also name the host of the server's address).
# MCP_SERVER_TRUSTED_CAS=/certs/server-cas.pem
# The gateway never connects to loopback, link-local, unspecified or multicast addresses, nor to the metadata addresses of the clouds
# (169.254.169.254, fd00:ec2::254, 100.100.100.200, 192.0.0.192). Add your own, comma-separated IP addresses or CIDR ranges:
# MCP_SERVER_REFUSED_ADDRESSES=10.9.0.0/16,203.0.113.7

# Only when the identity provider has a certificate from your company CA (see README.md):
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/certs/jvm-truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit

# Only for systems with token exchange and for clients that discover the authorization server:
# MCP_OIDC_AUTHORIZATION_SERVER=
# MCP_OIDC_TOKEN_URI=
# MCP_OIDC_CLIENT_ID=
# MCP_OIDC_CLIENT_SECRET=
