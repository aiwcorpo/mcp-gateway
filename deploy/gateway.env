# Configuration of the gateway. Fill in the empty values; "docker compose up -d" tells you what is still missing.
# Passwords of the gateway's PostgreSQL and Redis, the internal JWT keys and the cursor keys are generated on the first start.

# The address users put in their AI client: the https origin of your reverse proxy in front of port 8080.
MCP_PUBLIC_URL=

# Identity provider (a Keycloak realm): issuer and the URL of its signing keys.
# For Keycloak: https://<host>/realms/<realm> and https://<host>/realms/<realm>/protocol/openid-connect/certs
MCP_OIDC_ISSUER=
MCP_OIDC_JWKS_URI=

# Credential broker: its internal TLS address. Its certificate must name mcp-credential-broker.internal; the host in the URL may differ.
MCP_BROKER_URL=
MCP_BROKER_TLS_NAME=mcp-credential-broker.internal

# Policy server: the directory of the main channel (it serves latest.json) and the id of the key that signs the bundles.
# The public key itself goes to certs/policies-main.public.pem.
MCP_POLICY_MAIN_URL=
MCP_POLICY_MAIN_KEY_ID=

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# MCP servers. Turn on the ones you run and give their address; each certificate must name mcp-<system>.internal.
MCP_SERVER_JIRA_ENABLED=false
MCP_SERVER_JIRA_MCP_URL=https://mcp-jira.internal:8443/mcp
MCP_SERVER_CONFLUENCE_ENABLED=false
MCP_SERVER_CONFLUENCE_MCP_URL=https://mcp-confluence.internal:8443/mcp
MCP_SERVER_GITLAB_ENABLED=false
MCP_SERVER_GITLAB_MCP_URL=https://mcp-gitlab.internal:8443/mcp
MCP_SERVER_SERVICEDESK_ENABLED=false
MCP_SERVER_SERVICEDESK_MCP_URL=https://mcp-servicedesk.internal:8443/mcp
MCP_SERVER_OPENSEARCH_ENABLED=false
MCP_SERVER_OPENSEARCH_MCP_URL=https://mcp-opensearch.internal:8443/mcp

# Only when the identity provider or the policy server has a certificate from your company CA (see README.md):
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/certs/jvm-truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit

# Only for OpenSearch (token exchange) and for clients that discover the authorization server:
# MCP_OIDC_AUTHORIZATION_SERVER=
# MCP_OIDC_TOKEN_URI=
# MCP_OIDC_CLIENT_ID=
# MCP_OIDC_CLIENT_SECRET=

# Only with a second policy channel for emergency changes:
# MCP_POLICY_OVERRIDES_URL=
# MCP_POLICY_OVERRIDES_KEY_ID=
# MCP_POLICY_OVERRIDES_KEY_FILE=/certs/policies-overrides.public.pem
