# Environment of the gateway: copy to /etc/mcp-gateway/mcp-gateway.env (root:gateway, mode 0640) and fill in the empty values.
# The internal JWT keys and the cursor keys are generated on the first start into /var/lib/mcp-gateway/secrets (read below).

SPRING_CONFIG_IMPORT=optional:configtree:/var/lib/mcp-gateway/secrets/gateway/env/

MCP_PUBLIC_URL=https://mcp.corp.test

# TLS on the public port 8080 (the hop from the reverse proxy). PEM files: the certificate of the gateway (SAN = the name the proxy
# connects with, from the internal CA; scripts/gen-pki.sh makes mcp-gateway with the SAN mcp-gateway.internal) and its private key
# in PKCS#8, mode 0640 root:gateway. A key readable by others stops the start. Set ENABLED=false only when the proxy shares the host.
MCP_PUBLIC_TLS_ENABLED=true
MCP_PUBLIC_TLS_CERTIFICATE=/etc/mcp-gateway/tls/tls.crt
MCP_PUBLIC_TLS_PRIVATE_KEY=/etc/mcp-gateway/tls/tls.key
MCP_OIDC_ISSUER=https://idp.corp.test/realms/corp
MCP_OIDC_JWKS_URI=https://idp.corp.test/realms/corp/protocol/openid-connect/certs
MCP_OIDC_AUDIENCE=mcp-gateway
# Only for systems with the credential type token-exchange (OpenSearch):
MCP_OIDC_TOKEN_URI=
MCP_OIDC_CLIENT_ID=
MCP_OIDC_CLIENT_SECRET=

# Admin API: the portal's certificate CN and the azp of its exchanged token; the offboarding certificate CN.
MCP_ADMIN_CLIENT_CNS=mcp-portal-bff
MCP_ADMIN_AUTHORIZED_PARTY=mcp-portal-bff
MCP_ADMIN_OFFBOARDING_CLIENT_CNS=mcp-offboarding

# mTLS: the certificate of the gateway (SAN mcp-gateway.internal, server and client use) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-gateway/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-gateway/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

MCP_BROKER_URL=https://mcp-credential-broker.internal:8443
MCP_BROKER_TLS_NAME=mcp-credential-broker.internal

# One line per system you run (the others stay disabled). The server certificate must have the SAN mcp-<system>.internal.
MCP_SERVER_JIRA_MCP_URL=https://mcp-jira.internal:8443/mcp
MCP_SERVER_JIRA_ENABLED=true
MCP_SERVER_CONFLUENCE_ENABLED=false
MCP_SERVER_GITLAB_ENABLED=false
MCP_SERVER_SERVICEDESK_ENABLED=false
MCP_SERVER_OPENSEARCH_ENABLED=false

MCP_DB_URL=jdbc:postgresql://postgres.corp.internal:5432/gateway
MCP_DB_USER=gateway
MCP_DB_PASSWORD=

# Redis with at least one replica: the gateway refuses to start with MCP_REDIS_WAIT_REPLICAS below 1.
MCP_REDIS_HOST=redis.corp.internal
MCP_REDIS_PORT=6379
MCP_REDIS_USER=gateway
MCP_REDIS_PASSWORD=
MCP_REDIS_KEY_PREFIX=gw:
MCP_REDIS_WAIT_REPLICAS=1

# Signed policy bundles (https only) and the public keys of both channels (Ed25519, SPKI PEM).
MCP_POLICY_MAIN_URL=https://policies.corp.internal/policies/main/
MCP_POLICY_MAIN_KEY_ID=
MCP_POLICY_MAIN_KEY_FILE=/etc/mcp-gateway/policies-main.public.pem
MCP_POLICY_OVERRIDES_URL=https://policies.corp.internal/policies/overrides/
MCP_POLICY_OVERRIDES_KEY_ID=
MCP_POLICY_OVERRIDES_KEY_FILE=/etc/mcp-gateway/policies-overrides.public.pem
# Rollback protection across restarts; one directory per instance. systemd creates it (StateDirectory=mcp-gateway).
MCP_POLICY_STATE_DIR=/var/lib/mcp-gateway/policy-state

# The internal JWT keys and the cursor keys are generated on the first start. A second instance needs the same ones: copy
# /var/lib/mcp-gateway/secrets/gateway from the first instance before its first start.

# Client certificate CNs that may read /actuator/prometheus (comma separated). Empty: nobody.
MCP_METRICS_CLIENT_CNS=
